APP_NAME="Tech Commerce"
APP_ENV=local
APP_KEY=
# Local template only. See docs/ENVIRONMENTS-RELEASE.md before staging/production.
APP_DEBUG=false
APP_URL=http://127.0.0.1:8086

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=tech_commerce
DB_USERNAME=tech_commerce
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Local HTTP only. Require true for staging/production over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# Use distinct names and stores per environment; never share production Redis.
CACHE_PREFIX=tech_commerce_local_cache_
REDIS_PREFIX=tech_commerce_local_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@tech-commerce.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverse proxy addresses allowed to set X-Forwarded-* (scheme, host, port). Defaults to the
# loopback addresses, which covers nginx on the same host. Set it explicitly when the proxy is
# elsewhere; never use "*" on a server reachable from the internet.
# TRUSTED_PROXIES=127.0.0.1,::1

# V1-B availability (docs/V1-B-SCOPE.md). Required: the application refuses to boot without it.
# Minutes an offer observation stays fresh, for manual and supplier data alike. The expected value
# differs per environment: local/testing use a long window so manual test data does not need to be
# re-observed during the day; production must use a short window matching the supplier polling
# cadence (still to be defined). Never copy this local value to staging or production.
COMMERCE_AVAILABILITY_TTL_MINUTES=10080
# Local cart hold (V1-B-SCOPE §5). Defaults to 60 when unset.
# COMMERCE_CART_HOLD_MINUTES=60

# Public contact channels shown on /venta-corporativa. Not secrets: they reach the browser.
# Leave them unset until the real ones are confirmed; the page then says the channel is being
# set up instead of publishing an address nobody answers. The number may be written in any local
# format (8000-0000, 8000 0000, +506 8000-0000): the wa.me link adds the country code by itself.
# STOREFRONT_WHATSAPP=8000-0000
# STOREFRONT_CORPORATE_EMAIL=corporativo@example.test

# No supplier or payment credentials until verified integrations exist.
# Public catalog remains noindex in code, including production, until V1-H/J.
